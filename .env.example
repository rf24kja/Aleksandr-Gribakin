# Resend API key for form submissions
RESEND_API_KEY=re_xxxxxxxxxxxx

# Telegram control bot (local dev tool — never commit real values)
TELEGRAM_BOT_TOKEN=000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELEGRAM_CHAT_ID=000000000

# Optional: forward consult-form submissions to Telegram from the serverless
# function. Leave unset to disable — the function never imports the bot.
TELEGRAM_NOTIFY=0
