# --- Consult form delivery -------------------------------------------------
#
# Without at least one channel below, /api/consult answers 503 and the form
# tells the visitor to write directly instead. It never reports success for a
# message that went nowhere. Check what a deployment has configured with:
#
#     curl https://<your-domain>/api/consult      ->  {"delivery":"none"}
#
# These belong in the Vercel project's Environment Variables (Production),
# not in a committed file. Redeploy after adding them.

# Resend API key. Sign up at resend.com, create a key, paste it here.
RESEND_API_KEY=re_xxxxxxxxxxxx

# From address. Optional. Defaults to Resend's shared onboarding@resend.dev,
# which needs no DNS setup but only delivers to the address that owns the
# Resend account. Set this to noreply@<your-domain> only after that domain is
# verified in Resend, otherwise every send is rejected.
# MAIL_FROM=noreply@example.com

# --- Telegram ---------------------------------------------------------------
# Control bot for local dev. Never commit real values.
TELEGRAM_BOT_TOKEN=000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TELEGRAM_CHAT_ID=000000000

# Set to 1 to also forward consult submissions to Telegram. Counts as a
# delivery channel on its own, so an email outage alone does not lose a
# message. Leave at 0 to disable — the function never imports the bot.
TELEGRAM_NOTIFY=0
